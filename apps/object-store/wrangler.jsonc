{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "worknet-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "PLATFORM",
        "class_name": "PlatformCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "platform-v1",
      "new_sqlite_classes": [
        "PlatformCoordinator"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "PLATFORM_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "PLATFORM_JUDGE_MODEL": "@cf/openai/gpt-oss-120b"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "worknet-platform",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "assets": {
    "directory": "../explorer/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
