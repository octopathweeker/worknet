# Template only; applications do not automatically load this file.
# Use separate environments for deployer, requester and each worker.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=
REQUESTER_ADDRESS=
DEPLOYMENT_DIR=.runtime/testnet
DEMO_CONFIG=.runtime/testnet/config.json
STORAGE_URL=https://objects.example.com
STORAGE_UPLOAD_TOKEN=
REQUESTER_API_TOKEN=
AGENT_PRIVATE_KEY=
API_PORT=8788
UI_ORIGIN=
REQUESTER_API_URL=http://127.0.0.1:8788
# All three required for real model calls; keep real values out of Git.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_MS=45000
# Only for a proxy using fake-IP DNS:
RESEARCH_DOH=false
# Judge quorum (JEV completion verdicts): each judge node gets its own key.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=20000
# For deploy-testnet.ts: distinct judge addresses written into TaskManager.
JUDGE_ADDRESSES=
JUDGE_THRESHOLD=2
# Per-judge service (apps/judge): one JUDGE_PRIVATE_KEY per instance.
JUDGE_PRIVATE_KEY=
JUDGE_PORT=8791
JUDGE_ID=judge-1

# M6 Node judge may reuse an OpenRouter key; calls /api/v1/systemone.
# Cloud judge Workers reuse the existing platform Secret through Service Bindings.
# JEV_MODEL=jev-1.13
# See docs/M6-RELEASE.md; do not copy secret values into Wrangler vars.

# Optional Mera private-delivery review service key (not a user's account key).
# Configure as a Worker secret; retain the same key while pending tasks reference it.
# DELIVERY_REVIEW_KEY=0x<64-lowercase-hex-characters>
# ERC8004_CONFIG={"registry":"<verified-registry>","workers":{}}
# MPP_TOOL_CONFIG={"endpoint":"https://provider.example/services/transfers","provider":{"chainId":"10143","registry":"<verified-registry>","agentId":"1"},"maxPerCall":"1000","maxPerTask":"2000","maxPerDay":"10000","maxGasWei":"1000000000000000"}
# MPP_PAYER_KEY=0x<dedicated-platform-tool-payment-key>
# MPP_SERVICE_CONFIG={"agent":{"chainId":"10143","registry":"<verified-registry>","agentId":"1"},"recipient":"<agentWallet>","priceBaseUnits":"1000","origin":"https://provider.example"}
# MPP_SERVICE_SECRET=<at-least-32-random-characters>
# Users obtain MON/USDC themselves using the links in the account page. No faucet pool.
